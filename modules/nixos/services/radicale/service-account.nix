# Radicale's per-service-account surface, beside the app like ./user.nix. Access comes from the owner's grant.
{ lib, ... }:
let
  secretsDir = "/var/lib/homelab-secrets"; # persistent, see runtime-secrets.nix
in
{
  options.selfhost.serviceAccounts = lib.mkOption {
    type = lib.types.attrsOf (
      lib.types.submodule (
        { name, ... }:
        {
          options.services.radicale = {
            enable = lib.mkEnableOption "a Radicale login for this service account";

            passwordFile = lib.mkOption {
              type = lib.types.str;
              default = "${secretsDir}/radicale-password-${name}";
              defaultText = lib.literalMD "a password generated under `runtimeSecretsDir`";
              description = "File holding the login's password, generated by default for its client elsewhere to copy.";
            };
          };
        }
      )
    );
  };
}
